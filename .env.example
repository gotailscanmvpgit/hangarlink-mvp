# HangarLink MVP Environment Variables
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=0

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///hangarlink.db

# Stripe (Test Mode)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook (optional - for production)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Upload
UPLOAD_FOLDER=static/uploads

# Server
PORT=5000

# SendPulse SMTP (password resets, booking emails, alerts)
# Sign up free at https://sendpulse.com => SMTP Settings => Get credentials
# Verify your domain (tryhangarlinks.com) in the SendPulse dashboard first
SENDPULSE_USERNAME=your_sendpulse_smtp_username
SENDPULSE_PASSWORD=your_sendpulse_smtp_password
MAIL_DEFAULT_SENDER=no-reply@tryhangarlinks.com

# 🔐 Social Authentication (OAuth2)
# Get Google credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Get Apple credentials from https://developer.apple.com/
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# 🤖 AI & External APIs
OPENAI_API_KEY=sk-your-openai-key-here
GROK_API_KEY=your-grok-key-here
OPENWEATHER_API_KEY=your-openweather-key-here
AVIATIONSTACK_KEY=your-aviationstack-key-here

